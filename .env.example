# URI Postgres del proyecto Supabase salteñanga (Database → Connection string → URI).
# Debe empezar con postgresql://. Usar el session pooler si el host directo
# db.<ref>.supabase.co no resuelve: aws-1-us-west-2.pooler.supabase.com:5432/postgres
# En el pooler el usuario es <rol>.<ref>, p. ej. saltenanga_app.<ref>.
# NO es la URL https://jxz...supabase.co de la API.
DATABASE_URL=
# Secreto para firmar los JWT de sesión (usá uno largo y aleatorio).
JWT_SECRET=
API_PORT=3001
WEB_PORT=3000
CORS_ORIGIN=http://localhost:3000
CART_COOKIE_DAYS=30
SESSION_REFRESH_DAYS=30
BUSINESS_OPEN_TIME=06:00
BUSINESS_CLOSE_TIME=11:00
PICKUP_WINDOW_MINUTES=30
LOW_TIME_WARNING_MINUTES=10
NODE_ENV=development
